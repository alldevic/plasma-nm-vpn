#!/bin/bash
# Down followed 20 ms later by up of proto-hy2, 10 times: what the old instance sees at its decision points. Run as root.
log=/run/pnv-proto.log; P=proto-hy2
daemons() { pgrep -f '^/usr/local/libexec/pnv-proto-service' | tr '\n' ' '; }
nmcli connection down $P >/dev/null 2>&1; sleep 1; nmcli --wait 30 connection up $P >/dev/null; sleep 0.5
for i in $(seq 1 10); do
  : > $log; old=$(daemons)
  nmcli connection down $P >/dev/null 2>&1 & sleep 0.02; nmcli --wait 30 connection up $P >/dev/null 2>&1; wait; sleep 1.5
  o=${old% }
  sc=$(grep "^pnv-proto\[$o\].*probe at state-changed" $log | tail -1 | sed -E 's/.*\(cache\) \[([^]]*)\] \(fresh\) \[([^]]*)\], takeover marker (\w+)/cache=[\1] fresh=[\2] marker=\3/')
  dc=$(grep "^pnv-proto\[$o\].*probe at disconnect" $log | sed -E 's/.*\(cache\) \[([^]]*)\] \(fresh\) \[([^]]*)\], takeover marker (\w+)/cache=[\1] fresh=[\2] marker=\3/')
  reason=$(grep "^pnv-proto\[$o\].*deactivating, reason" $log | sed 's/.*reason //')
  printf "#%-2s old %s reason %-18s last state-changed: %-45s disconnect: %-45s new daemon [%s] %s\n" $i "$o" "$reason" "$sc" "$dc" "$(daemons)" "$(nmcli -g GENERAL.STATE connection show $P)"
done
nmcli connection down $P >/dev/null 2>&1
