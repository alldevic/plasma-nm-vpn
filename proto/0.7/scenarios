#!/bin/bash
# The 0.7 deactivation and re-activation scenarios. Run as root after ./install; prints a log.
set -uo pipefail

here=$(dirname "$(readlink -f "$0")")
log=/run/pnv-proto.log
profile=proto-hy2

uuid() { nmcli -g connection.uuid connection show $profile; }
daemons() { pgrep -f '^/usr/local/libexec/pnv-proto-service' | tr '\n' ' '; }
leftovers() {
  echo "  left: units [$(systemctl list-units --all --no-legend 'plasma-nm-vpn-*' | awk '{print $1 "=" $3}' | sed -E 's/plasma-nm-vpn-([a-z]+)-[^=]*/\1/' | tr '\n' ' ')] tun $(ip -br link | grep -c '^pnv-') run dirs $(ls /run/plasma-nm-vpn 2>/dev/null | wc -l) daemons [$(daemons)]"
}
wait_exit() { # wait_exit PID...: until all exited, prints ms
  local t0; t0=$(date +%s%N)
  for _ in $(seq 300); do
    local alive=0; for p in "$@"; do kill -0 "$p" 2>/dev/null && alive=1; done
    [ $alive = 0 ] && break; sleep 0.05
  done
  echo $(( ($(date +%s%N) - t0) / 1000000 ))
}
up() { nmcli --wait 30 connection up $profile >/dev/null 2>&1; sleep 0.5; }
show() { sed 's/^/  /' $log; : > $log; }
routes() { echo "  routes: default via $(ip -4 route show default | awk '{print $5}' | tr '\n' ' '), /32 $(ip route show 198.51.100.1 | wc -l), resolv $(grep ^nameserver /etc/resolv.conf | awk '{print $2}' | tr '\n' ' ')"; }

: > $log
echo "== nmcli connection down"
up; : > $log; p=$(daemons)
nmcli connection down $profile >/dev/null
echo "  daemon exit $(wait_exit $p) ms after down returned"; show; leftovers; routes

echo "== kill -9 of the daemon"
up; : > $log; p=$(daemons)
kill -9 $p; sleep 3
echo "  NM state: $(nmcli -g GENERAL.STATE connection show $profile 2>/dev/null || echo none)"
show; journalctl -u "plasma-nm-vpn-guard-$(uuid).service" --since -5s --no-pager -o cat | grep -E 'guard-cleanup|cleaned|nothing' | sed 's/^/  guard: /'
leftovers; routes

echo "== systemctl restart NetworkManager"
up; : > $log; p=$(daemons)
systemctl restart NetworkManager; sleep 8
echo "  old daemon $p: $(kill -0 $p 2>/dev/null && echo alive || echo gone); NM state of $profile: $(nmcli -g GENERAL.STATE connection show $profile 2>/dev/null || echo none)"
show; leftovers; routes
nmcli connection down $profile >/dev/null 2>&1; sleep 2

echo "== nmcli connection delete of the active profile"
up; : > $log; p=$(daemons)
nmcli connection delete $profile >/dev/null
echo "  daemon exit $(wait_exit $p) ms"; show; leftovers
"$here/install" >/dev/null 2>&1

for i in $(seq 1 10); do
  echo "== re-activation $i (profile active)"
  up; : > $log; old=$(daemons)
  nmcli --wait 30 connection up $profile >/dev/null 2>&1; sleep 1
  echo "  old $old exit, new [$(daemons)], state $(nmcli -g GENERAL.STATE connection show $profile)"
  show
done

for i in 1 2 3; do
  echo "== re-activation $i while the old one is still activating"
  nmcli connection down $profile >/dev/null 2>&1; sleep 1; : > $log
  nmcli connection up $profile >/dev/null 2>&1 & sleep 0.05
  nmcli --wait 30 connection up $profile >/dev/null 2>&1; wait; sleep 1
  echo "  daemons [$(daemons)], state $(nmcli -g GENERAL.STATE connection show $profile)"
  show
done
nmcli connection down $profile >/dev/null 2>&1; sleep 2; leftovers
