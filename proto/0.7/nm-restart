#!/bin/bash
# What the daemon sees on systemctl restart NetworkManager with the tunnel up, 3 times. Run as root.
log=/run/pnv-proto.log; P=proto-hy2
for i in 1 2 3; do
  nmcli --wait 30 connection up $P >/dev/null; sleep 0.5; : > $log
  p=$(pgrep -f '^/usr/local/libexec/pnv-proto-service' | head -1)
  systemctl restart NetworkManager; sleep 8
  echo "restart #$i: daemon $p $(kill -0 $p 2>/dev/null && echo alive || echo gone); before Disconnect: [$(grep "^pnv-proto\[$p\]" $log | sed -n '/Disconnect: start/q;p' | sed 's/^[^ ]* [^ ]* //' | tr '\n' ';')] VPN after: $(nmcli -g GENERAL.STATE connection show $P || echo none); /32 left: $(ip route show 198.51.100.1 | wc -l)"
  ip route del 198.51.100.1 2>/dev/null
done
