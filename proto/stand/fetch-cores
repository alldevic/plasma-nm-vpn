#!/bin/bash
# Install the pinned cores into $PNV_BIN (default /opt/pnv-proto/bin) for the bench.
# Needs curl, unzip, git, make, a C compiler and Go >= 1.25.
set -euo pipefail

bin=${PNV_BIN:-/opt/pnv-proto/bin}
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cd "$work"

fetch() { # url sha256 file
  curl -fsSL -o "$3" "$1"
  echo "$2  $3" | sha256sum -c --quiet -
}

clone() { # repo tag commit dir
  git clone -q -c advice.detachedHead=false --depth 1 --branch "$2" "https://github.com/$1.git" "$4"
  [ "$(git -C "$4" rev-parse HEAD)" = "$3" ] || { echo "$1 $2: not commit $3" >&2; exit 1; }
}

mkdir -p "$bin"

fetch https://github.com/SagerNet/sing-box/releases/download/v1.14.4/sing-box-1.14.4-linux-amd64.tar.gz \
  699a1b510aa4396b2176d32d1181920399ebf1e267835da6f3b598d0f7c24968 sing-box.tar.gz
tar -xzf sing-box.tar.gz --strip-components=1 -C "$bin" sing-box-1.14.4-linux-amd64/sing-box

fetch https://github.com/XTLS/Xray-core/releases/download/v26.11.9/Xray-linux-64.zip \
  b651f7e1d9966ee2c1b1ee1bf8b52c72771824d3065dce96bbc8bcc19ed95f82 xray.zip
unzip -q -o xray.zip xray -d "$bin"

clone amnezia-vpn/amneziawg-go v3.1.20261116 08fe3d33bbb116be09a6183d02609311b8b0c9e8 amneziawg-go
(cd amneziawg-go && CGO_ENABLED=0 go build -trimpath -o "$bin/amneziawg-go" .)

clone amnezia-vpn/amneziawg-tools v3.1.20260812 ee0f0a9aa34ff0a0da4b3433b9512781cfe02843 amneziawg-tools
make -s -C amneziawg-tools/src wg
install -m 0755 amneziawg-tools/src/wg "$bin/awg"

"$bin/sing-box" version | head -1
"$bin/xray" version | head -1
"$bin/amneziawg-go" --version
"$bin/awg" --version
