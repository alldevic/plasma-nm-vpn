#!/usr/bin/python3
# TLS 1.3 target for the Reality server: tls-target ADDR PORT CERT KEY.
import http.server, ssl, sys

addr, port, cert, key = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4]
ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
ctx.minimum_version = ssl.TLSVersion.TLSv1_3
ctx.set_alpn_protocols(["h2", "http/1.1"])
ctx.load_cert_chain(cert, key)
srv = http.server.ThreadingHTTPServer((addr, port), http.server.SimpleHTTPRequestHandler)
srv.socket = ctx.wrap_socket(srv.socket, server_side=True)
srv.serve_forever()
