#!/bin/sh
set -e

# On remove (not on upgrade) bring this core's connections down, so that their daemons clean up.
if [ "$1" = remove ] && [ -x /usr/lib/plasma-nm-vpn/deactivate-connections ]; then
    /usr/lib/plasma-nm-vpn/deactivate-connections org.freedesktop.NetworkManager.pnv.amneziawg
fi

#DEBHELPER#
