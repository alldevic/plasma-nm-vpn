#!/bin/bash
# check-tag <tag>: is this a release tag the pipeline may build? Only v<project version>, matching
# debian/changelog, on master or a release branch (release/<x.y>, for fixes to an older version).
# A core update is a new project version too (design.md, "Packages"). Run in a checkout with the remote branches fetched.
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/cores.sh"

tag=${1:?usage: check-tag <tag>}
version=$(dpkg-parsechangelog -l "$root/debian/changelog" -S Version)

[[ $tag =~ ^v([0-9]+\.[0-9]+\.[0-9]+)$ ]] || die "$tag is not a release tag (v<x.y.z>)"
[ "${BASH_REMATCH[1]}" = "$version" ] || die "$tag: debian/changelog is at $version"
git -C "$root" branch -r --contains HEAD | sed 's/^ *//' | grep -Eq '^origin/(master|release/[^ ]+)$' ||
  die "$tag is not on master or a release branch"
echo "$tag: project $version, cores: $(for c in sb xray amneziawg-go amneziawg-tools; do printf '%s %s ' "$c" "$(pin $c VERSION)"; done)"
