#!/bin/bash
# make-index <owner/repo> <indir> <outdir>: the release assets for <owner/repo> in <outdir>.
# Takes the .deb files and source archives from <indir>; every package whose name and version are already
# in the previous release's Packages is taken from that release instead, its sha256 checked against that
# Packages, which is checked against the previous InRelease. Then the signed flat apt index.
# Signs with the default key of $GNUPGHOME. KEYRING (default data/keyring/<repo>.gpg) checks the previous
# and the new InRelease. GITHUB_TOKEN, if set, is used for the GitHub API.
set -euo pipefail
shopt -s nullglob
. "$(dirname "$(readlink -f "$0")")/cores.sh"

repo=$1 in=$(readlink -f "$2") out=$3
name=${repo#*/}
keyring=$(readlink -f "${KEYRING:-$root/data/keyring/$name.gpg}")
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$out"
out=$(readlink -f "$out")

api() { curl -sS -o "$work/api.json" -w '%{http_code}' ${GITHUB_TOKEN:+-H "Authorization: Bearer $GITHUB_TOKEN"} "https://api.github.com/repos/$repo$1"; }
sha() { sha256sum "$1" | cut -d' ' -f1; }
# Asset names: GitHub turns "~" into "." and "+" is awkward in URLs, so both become "-" (0.9).
asset() { tr '+~' '--' <<<"$1"; }

# The previous release. Only "the repository has no published release" means a first release;
# anything else that fails stops the pipeline.
[ "$(api "")" = 200 ] || die "cannot read repository $repo"
case $(api /releases/latest) in
  200) prev=$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["tag_name"])' "$work/api.json") ;;
  404) prev= ;;
  *) die "cannot read the latest release of $repo" ;;
esac

if [ -n "$prev" ]; then
  base=https://github.com/$repo/releases/download/$prev
  curl -fsSL -o "$work/InRelease" "$base/InRelease"
  curl -fsSL -o "$work/Packages" "$base/Packages"
  gpgv --keyring "$keyring" "$work/InRelease" 2>/dev/null || die "$prev: InRelease is not signed by $keyring"
  want=$(awk '/^SHA256:/ {s = 1; next} /^[^ ]/ {s = 0} s && $3 == "Packages" {print $1}' "$work/InRelease")
  [ "$(sha "$work/Packages")" = "$want" ] || die "$prev: Packages does not match its InRelease"
  echo "previous release: $prev"
else
  echo "no previous release in $repo: first release, nothing is carried over"
fi

for deb in "$in"/*.deb; do
  pkg=$(dpkg-deb -f "$deb" Package) ver=$(dpkg-deb -f "$deb" Version)
  if [ -n "$prev" ]; then
    entry=$(awk -v p="Package: $pkg" -v v="Version: $ver" 'BEGIN {RS = ""; FS = "\n"}
      {a = b = 0; for (i = 1; i <= NF; i++) {a = a || $i == p; b = b || $i == v}} a && b' "$work/Packages")
    if [ -n "$entry" ]; then
      file=$(sed -n 's/^Filename: //p' <<<"$entry") sum=$(sed -n 's/^SHA256: //p' <<<"$entry")
      curl -fsSL -o "$out/$file" "$base/$file"
      [ "$(sha "$out/$file")" = "$sum" ] || die "$file from $prev: sha256 differs from its Packages"
      echo "carried over $file ($pkg $ver) from $prev; fresh build discarded"
      continue
    fi
  fi
  file=$(asset "$(basename "$deb")")
  cp "$deb" "$out/$file"
  echo "fresh $file ($pkg $ver)"
done

# Source archives are rebuilt reproducibly; if a rebuild ever differs, the published one stays.
for src in "$in"/*.tar.xz; do
  file=$(basename "$src")
  if [ -n "$prev" ] && curl -fsSL -o "$work/$file" "$base/$file" 2>/dev/null; then
    cmp -s "$src" "$work/$file" || echo "warning: $file differs from the one in $prev; keeping the published one"
    cp "$work/$file" "$out/$file"
  else
    cp "$src" "$out/$file"
  fi
done

cd "$out"
apt-ftparchive packages . 2>/dev/null | sed 's|^Filename: \./|Filename: |' > Packages
xz -k Packages
# Written outside the release directory, or it would list itself.
apt-ftparchive -o APT::FTPArchive::Release::Origin=plasma-nm-vpn -o APT::FTPArchive::Release::Label=plasma-nm-vpn \
  release . > "$work/Release"
gpg --batch --yes --clearsign -o InRelease "$work/Release"
gpgv --keyring "$keyring" InRelease 2>/dev/null || die "the new InRelease does not verify with $keyring"
