#!/bin/bash
# check-golden sb|xray <binary>: every golden config for the pinned core version passes the core's own check
# (sing-box check, xray run -test). The AmneziaWG configs need an interface and are checked in the VM (3.1).
set -euo pipefail
. "$(dirname "$(readlink -f "$0")")/cores.sh"

core=$1 bin=$2
case $core in
  sb) version=$("$bin" version | sed -n 's/^sing-box version //p') dir=sing-box ;;
  xray) version=$("$bin" version | sed -n 's/^Xray \([0-9.]*\) .*/\1/p') dir=xray ;;
  *) die "usage: check-golden sb|xray <binary>" ;;
esac
[ "$version" = "$(pin "$core" VERSION)" ] || die "$bin is $core $version, cores/$core.env pins $(pin "$core" VERSION)"
dir=$root/tests/golden/$dir-$version
[ -d "$dir" ] || die "no golden files for $core $version"
for f in "$dir"/*.json; do
  case $core in
    sb) "$bin" check -c "$f" ;;
    xray) "$bin" run -test -c "$f" >/dev/null ;;
  esac || die "the $core check failed for ${f#"$root"/}"
done
echo "$core $version: $(ls "$dir"/*.json | wc -l) golden configs pass the core's check"
