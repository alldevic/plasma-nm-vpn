<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>plasma-nm-vpn</vendor>
  <vendor_url>https://github.com/alldevic/plasma-nm-vpn</vendor_url>
  <action id="io.github.alldevic.plasma-nm-vpn.guard">
    <description>Clear a VPN kill switch block</description>
    <message>Authentication is required to remove a kill switch block that cuts this computer off the network</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/plasma-nm-vpn-guard</annotate>
  </action>
</policyconfig>
