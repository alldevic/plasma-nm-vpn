# cmake -DFILE=<json> -DSERVICE=... -DNAME_RU=... -DDESCRIPTION_RU=... -P check-metadata.cmake
file(READ ${FILE} json)
string(JSON service GET "${json}" X-NetworkManager-Services)
string(JSON name_ru GET "${json}" KPlugin Name[ru])
string(JSON description_ru GET "${json}" KPlugin Description[ru])
string(JSON category GET "${json}" KPlugin Category)
foreach(pair "service;SERVICE" "name_ru;NAME_RU" "description_ru;DESCRIPTION_RU")
    list(GET pair 0 got)
    list(GET pair 1 want)
    if(NOT "${${got}}" STREQUAL "${${want}}")
        message(FATAL_ERROR "${got}: '${${got}}', expected '${${want}}'")
    endif()
endforeach()
if(NOT category STREQUAL "VPNService")
    message(FATAL_ERROR "Category: '${category}'")
endif()
