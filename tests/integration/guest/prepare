#!/bin/bash
# prepare <cores dir> [<debs dir>]: in the test VM, as root: the core user, /run/amneziawg and the cores
# where the bench expects them, the system under test from the CI-built packages (offline: the image has
# their dependencies); then the bench.
set -euo pipefail

here=$(dirname "$(readlink -f "$0")")
cores=$(readlink -f "$1")

getent passwd plasma-nm-vpn >/dev/null || useradd --system --no-create-home --shell /usr/sbin/nologin plasma-nm-vpn
install -d -o plasma-nm-vpn -g plasma-nm-vpn -m 0750 /run/amneziawg
install -D -m 0755 -t /opt/pnv-proto/bin "$cores"/bin/*
if [ -n "${2:-}" ]; then
  apt-get install -y -q "$(readlink -f "$2")"/plasma-nm-vpn-common_*.deb \
    "$(readlink -f "$2")"/plasma-nm-vpn-sb_*.deb "$(readlink -f "$2")"/plasma-nm-vpn-amneziawg_*.deb \
    "$(readlink -f "$2")"/plasma-nm-vpn-xray_*.deb
fi
"$here/../stand/stand-up" all
