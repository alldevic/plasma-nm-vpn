#!/bin/bash
# guard-cleanup --daemon-gone <uuid>: prototype of plasma-nm-vpn-guard --daemon-gone, the guard unit's
# ExecStop. Acts only if the run directory is still there, i.e. the daemon did not clean up itself.
set -uo pipefail

uuid=$2
tun=pnv-${uuid:0:8}
run=/run/plasma-nm-vpn/$uuid
core=plasma-nm-vpn-core-$uuid.service
chain=${uuid:0:8}

echo "guard-cleanup $(date +%T.%3N): uid=$(id -u) $(grep CapEff /proc/self/status | tr -d '\t') core=$(systemctl show -p ActiveState --value "$core")"

if [ ! -d "$run" ]; then
  echo "nothing to do"
  exit 0
fi

busctl call org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager \
  StopUnit ss "$core" replace >/dev/null 2>&1
ip tuntap del dev "$tun" mode tun 2>/dev/null
nft delete chain inet plasma_nm_vpn "out-$chain" 2>/dev/null
nft delete chain inet plasma_nm_vpn "fwd-$chain" 2>/dev/null
rm -rf "$run"
echo "cleaned up $tun, chains, $run"
# Test hook: fail once.
rm /run/pnv-guard-fail-once 2>/dev/null && exit 1
exit 0
